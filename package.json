{
    "name": "wayseeker",
    "version": "0.1.0",
    "description": "Wayseeker：按工作流探索设计、开发与创意工具的双语指南",
    "license": "MIT",
    "private": true,
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cookabc/wayseeker.git"
    },
    "keywords": [
        "nextjs",
        "react",
        "tailwindcss",
        "curated",
        "directory",
        "i18n",
        "typescript"
    ],
    "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
    "scripts": {
        "dev": "next dev -p 4000",
        "build": "next build",
        "start": "next start",
        "test": "node --experimental-strip-types --test",
        "lint": "biome check src",
        "lint:fix": "biome check --write src",
        "format": "biome format --write src",
        "format:check": "biome format src",
        "typecheck": "tsc --noEmit",
        "check": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test",
        "download-previews": "node scripts/download-previews.js",
        "optimize-previews": "node scripts/optimize-previews.js",
        "test:e2e": "pnpm build && playwright test",
        "test:e2e:built": "playwright test"
    },
    "dependencies": {
        "@phosphor-icons/react": "^2.1.10",
        "@radix-ui/react-tooltip": "^1.4.1",
        "clsx": "^2.1.1",
        "i18next": "^27.1.3",
        "next": "^16.4.6",
        "next-themes": "^0.4.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^18.0.2",
        "tailwind-merge": "^3.7.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.8",
        "@playwright/test": "1.65.1",
        "@tailwindcss/postcss": "^4.3.5",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "postcss": "^8.5.33",
        "sharp": "^0.35.5",
        "tailwindcss": "^4.3.5",
        "typescript": "7.0.2"
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
